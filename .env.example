# Copy this file to .env for local development.
# Never commit .env. Cloud Run secrets go in the Cloud Run console, not GitHub.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Optional: allow Vercel preview URLs from the browser
# CORS_ALLOWED_ORIGIN_REGEXES=https://.*\\.vercel\\.app

# TourAPI (한국관광공사)
TOUR_API_SERVICE_KEY=

# AI itinerary generation (triptailor_ai). Default provider is fake if unset.
# OPENAI_API_KEY=
# DEFAULT_LLM_PROVIDER=fake

# --- Database ---
# Cloud Run / Neon: set DATABASE_URL (pooled connection string recommended).
# Leave DB_HOST empty when using DATABASE_URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# Neon pooled host looks like: ep-xxxx-pooler.region.aws.neon.tech
# If the host contains "-pooler" or port is 6543, Django disables server-side cursors.
# DB_DISABLE_SERVER_SIDE_CURSORS=True
# DB_CONN_MAX_AGE=0
# DB_SSLMODE=require

# Local runserver: leave DB_HOST empty to use SQLite.
# docker compose: DB_HOST is overridden to the compose Postgres service.
DB_HOST=
DB_PORT=5432
DB_NAME=triptailor
DB_USER=triptailor
DB_PASSWORD=
DB_SSLMODE=prefer

# docker compose local Postgres (do not use these values in production)
POSTGRES_DB=triptailor
POSTGRES_USER=triptailor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Gunicorn / container
# Cloud Run injects PORT. Do not hardcode a production port.
PORT=8080
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=0
