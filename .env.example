# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Optional: allow Vercel preview URLs
# CORS_ALLOWED_ORIGIN_REGEXES=https://.*\\.vercel\\.app

# --- Database ---
# Production / Neon: set DATABASE_URL and leave DB_HOST empty.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Local runserver: leave DB_HOST empty to use SQLite.
# docker compose: DB_HOST is overridden to the compose Postgres service.
DB_HOST=
DB_PORT=5432
DB_NAME=triptailor
DB_USER=triptailor
DB_PASSWORD=
DB_SSLMODE=prefer

# docker compose local Postgres (do not use these values in production)
POSTGRES_DB=triptailor
POSTGRES_USER=triptailor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Gunicorn / container
PORT=8080
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
